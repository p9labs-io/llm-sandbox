# Hosts the agent container is allowed to reach. Extended POSIX regexes, matched
# against the destination hostname. Everything not listed here is refused.
#
# Edit this file and re-run `make egress-restart` to apply changes.

# ── Claude Code: required ─────────────────────────────────────────────────────
^api\.anthropic\.com$
^platform\.claude\.com$
^claude\.ai$
^claude\.com$

# ── Claude Code: optional but expected by parts of the CLI ────────────────────
^downloads\.claude\.ai$
^code\.claude\.com$
^storage\.googleapis\.com$
^raw\.githubusercontent\.com$

# ── Antigravity CLI ───────────────────────────────────────────────────────────
# generativelanguage.googleapis.com carries model requests when modelProvider is
# "gemini". The accounts/oauth2 hosts are only needed for the browser sign-in
# flow — drop them if you authenticate with GEMINI_API_KEY.
^antigravity\.google$
^generativelanguage\.googleapis\.com$
^accounts\.google\.com$
^oauth2\.googleapis\.com$

# ── Developer tooling ─────────────────────────────────────────────────────────
# Comment out anything you do not need. Each entry is a channel a compromised or
# prompt-injected session could push data out through, so keep the list short.
^registry\.npmjs\.org$
^github\.com$
^codeload\.github\.com$
^objects\.githubusercontent\.com$
^deb\.debian\.org$
^pypi\.org$
^files\.pythonhosted\.org$
^proxy\.golang\.org$
^sum\.golang\.org$
^crates\.io$
^static\.crates\.io$
^index\.crates\.io$
